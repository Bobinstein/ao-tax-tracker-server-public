# Server Configuration
PORT=3000

# Public API base URL (used by admin scripts and optional remote DistributionService)
# API_BASE_URL=http://localhost:3000

# Cassandra Configuration (optional overrides)
# CASSANDRA_HOST=localhost
# CASSANDRA_DATACENTER=datacenter1

# CoinGecko API (optional; improves rate limits for price history)
# COINGECKO_API_KEY=your-coingecko-api-key

# Admin bypass for local/ops tooling (X-Auth-Bypass). Use a long random secret in production.
# ADMIN_AUTH_BYPASS_CODE=your-strong-random-secret

# Stripe (optional; payments / checkout / webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Arweave/AO wallet for signing Manual-Subscribe and related messages.
# Path to a JWK JSON file, or the raw/base64 wallet JSON itself.
# MESSAGE_KEY_FILE=./path/to/wallet.json

# Payment process (optional override)
# PAYMENT_PROCESS_ID=

# When false, auth may call AO/HyperBEAM for subscription state.
# Default behavior keeps AO payment-process checks disabled.
# DISABLE_AO_PAYMENT_PROCESS=true
