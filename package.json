    "cassandra-driver": "^4.7.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jspdf": "^2.5.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.2",
    "stripe": "^17.5.0",
    "yahoo-finance2": "^3.11.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
